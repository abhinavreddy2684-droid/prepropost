DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://prepropost:prepropost@db:5432/prepropost
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1
# Refresh-token cookie (HttpOnly; max-age follows JWT_REFRESH_DAYS). The token is never in a body.
# Secure defaults to off locally and on under config.settings.production. SameSite=None needs Secure.
# Leave DOMAIN unset (host-only cookie) unless API and frontend must share a parent domain.
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_REFRESH_COOKIE_PATH=/api/auth/
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAMESITE=Lax
AUTH_REFRESH_COOKIE_DOMAIN=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=Pre Pro Post <no-reply@prepropost.local>
FRONTEND_URL=http://localhost:5173
# Browser origins allowed to call /api with credentials (comma-separated). Defaults to FRONTEND_URL.
# Never a wildcard: the refresh cookie rides on these requests.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Media storage. Locally: the MinIO service in docker-compose. Staging/production: AWS S3
# (ap-south-1), leave both endpoint URLs empty and use an IAM user limited to the bucket.
MEDIA_STORAGE_ENDPOINT_URL=http://minio:9000
MEDIA_STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:9000
MEDIA_STORAGE_BUCKET=prepropost-media
MEDIA_STORAGE_REGION=ap-south-1
MEDIA_STORAGE_ACCESS_KEY_ID=minioadmin
MEDIA_STORAGE_SECRET_ACCESS_KEY=change-me-minio-secret
MEDIA_CORS_ALLOWED_ORIGINS=http://localhost:5173
